<?xml version="1.0" encoding="utf-8"?>
<widget id="com.mendix.widget.custom.omniviz.OmniViz" pluginWidget="true" needsEntityContext="true"
        xmlns="http://www.mendix.com/widget/1.0/">
    <name>OmniViz Universal Visualizations &amp; Maps</name>
    <description>Universal, blazing fast data visualizations, geospatial maps, and hierarchical drill-down performance analytics powered by ECharts and D3.</description>
    <icon/>
    <properties>
        <!-- TAB 1: CHART TYPE & THEME -->
        <propertyGroup caption="Chart Settings">
            <property key="chartType" type="enumeration" defaultValue="bar">
                <caption>Chart Type</caption>
                <description>Select the visualization family</description>
                <enumerationValues>
                    <enumerationValue key="bar">Bar (Vertical)</enumerationValue>
                    <enumerationValue key="horizontalBar">Horizontal Bar (Leaderboard)</enumerationValue>
                    <enumerationValue key="stackedBar">Stacked Bar</enumerationValue>
                    <enumerationValue key="line">Line / Trend</enumerationValue>
                    <enumerationValue key="area">Area (Filled Gradient)</enumerationValue>
                    <enumerationValue key="stackedArea">Stacked Area</enumerationValue>
                    <enumerationValue key="scatter">Scatter / Performance Matrix</enumerationValue>
                    <enumerationValue key="pie">Pie / Donut</enumerationValue>
                    <enumerationValue key="rose">Nightingale Rose Chart</enumerationValue>
                    <enumerationValue key="radar">Radar / Spider Chart</enumerationValue>
                    <enumerationValue key="gauge">Gauge / Speedometer</enumerationValue>
                    <enumerationValue key="funnel">Funnel / Conversion</enumerationValue>
                    <enumerationValue key="heatmap">Heatmap Matrix</enumerationValue>
                    <enumerationValue key="treemap">Treemap (Hierarchical)</enumerationValue>
                    <enumerationValue key="sunburst">Sunburst Chart</enumerationValue>
                    <enumerationValue key="sankey">Sankey (Flow Diagram)</enumerationValue>
                    <enumerationValue key="candlestick">Candlestick (Financial OHLC)</enumerationValue>
                    <enumerationValue key="geoMap">Geospatial Map (Choropleth)</enumerationValue>
                    <enumerationValue key="geoScatter">Geospatial Scatter / Bubble Map</enumerationValue>
                </enumerationValues>
            </property>

            <property key="themePreset" type="enumeration" defaultValue="uberDark">
                <caption>Theme &amp; Palette</caption>
                <description>Visual styling preset inspired by Uber and modern design systems</description>
                <enumerationValues>
                    <enumerationValue key="uberDark">Uber Dark (Signature High Contrast)</enumerationValue>
                    <enumerationValue key="cleanModern">Enterprise Clean Light</enumerationValue>
                    <enumerationValue key="cyberNeon">Cyberpunk Neon</enumerationValue>
                    <enumerationValue key="d3Viridis">D3 Viridis Gradient</enumerationValue>
                    <enumerationValue key="d3Turbo">D3 Turbo Multi-hue</enumerationValue>
                    <enumerationValue key="pastel">Pastel Minimal</enumerationValue>
                </enumerationValues>
            </property>

            <property key="title" type="string" required="false" defaultValue="">
                <caption>Title</caption>
                <description>Chart header title</description>
            </property>

            <property key="subtitle" type="string" required="false" defaultValue="">
                <caption>Subtitle</caption>
                <description>Chart subtitle</description>
            </property>

            <property key="height" type="string" defaultValue="440px">
                <caption>Widget Height</caption>
                <description>Height in px or % (e.g., 440px, 100%, 500px)</description>
            </property>
        </propertyGroup>

        <!-- TAB 2: DATA INGESTION -->
        <propertyGroup caption="Data Ingestion">
            <property key="dataRoute" type="enumeration" defaultValue="mendix">
                <caption>Data Ingestion Mode</caption>
                <description>Select Mendix datasource (XPath/Database/Microflow) or direct REST API / JSON</description>
                <enumerationValues>
                    <enumerationValue key="mendix">Mendix Datasource (Entity List)</enumerationValue>
                    <enumerationValue key="api">Direct REST API / JSON Route</enumerationValue>
                </enumerationValues>
            </property>

            <!-- Route A: Mendix Datasource -->
            <property key="mendixDatasource" type="datasource" isList="true" required="false">
                <caption>Mendix Datasource</caption>
                <description>Entity list loaded via XPath, Database, Microflow, or Nanoflow</description>
            </property>

            <property key="xAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>X / Dimension / Region Name (e.g. State / District / Village)</caption>
                <description>Primary dimension or region attribute</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="DateTime"/>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                    <attributeType name="Decimal"/>
                </attributeTypes>
            </property>

            <property key="yAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Y / Measure / Value (e.g. Disbursement / Achievement %)</caption>
                <description>Numerical value / measure for the chart</description>
                <attributeTypes>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                    <attributeType name="Decimal"/>
                </attributeTypes>
            </property>

            <property key="seriesAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Series / Group By (Optional)</caption>
                <description>Category to group multiple series (e.g. Scheme, Sector, Bank)</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="secondaryAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Secondary Measure (Target / Total Eligible Population)</caption>
                <description>Used for scatter performance matrix, bubble size, or target comparison</description>
                <attributeTypes>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                    <attributeType name="Decimal"/>
                </attributeTypes>
            </property>

            <!-- Hierarchy attributes for National -> State -> District -> Village drill-down -->
            <property key="idAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Region ID / Code (e.g. State/District Census Code)</caption>
                <description>Unique identifier for hierarchical matching</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                </attributeTypes>
            </property>

            <property key="parentIdAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Parent Region ID / Code (For Hierarchical Drill)</caption>
                <description>Parent ID linking District to State, or Village to District</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                </attributeTypes>
            </property>

            <property key="levelAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Level (e.g. National, State, District, Village)</caption>
                <description>Administrative level of the record</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="latAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Latitude (For Geo Maps)</caption>
                <description>Latitude coordinate for geo scatter maps (-90 to 90)</description>
                <attributeTypes>
                    <attributeType name="Decimal"/>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="lngAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Longitude (For Geo Maps)</caption>
                <description>Longitude coordinate for geo scatter maps (-180 to 180)</description>
                <attributeTypes>
                    <attributeType name="Decimal"/>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="tooltipAttribute" type="attribute" dataSource="mendixDatasource" required="false">
                <caption>Custom Tooltip / Label Attribute</caption>
                <description>Custom tooltip text or HTML expression</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <!-- Route B: REST API / Dynamic JSON -->
            <property key="apiUrlOrJson" type="expression" required="false">
                <caption>API Endpoint URL or JSON String</caption>
                <description>REST API URL to fetch or dynamic JSON string from Microflow</description>
                <returnType type="String"/>
            </property>

            <property key="apiRefreshInterval" type="integer" defaultValue="0">
                <caption>Auto Refresh Interval (Seconds)</caption>
                <description>0 to disable; otherwise polls the API every N seconds for real-time dashboards</description>
            </property>

            <property key="jsonPathRoot" type="string" required="false" defaultValue="">
                <caption>JSON Path Root (Optional)</caption>
                <description>Root array property (e.g. 'data', 'items', 'records') if JSON is wrapped</description>
            </property>
        </propertyGroup>

        <!-- TAB 3: BENCHMARK & PERFORMANCE ANALYTICS -->
        <propertyGroup caption="Benchmark &amp; Analytics">
            <property key="enableBenchmarkLine" type="boolean" defaultValue="false">
                <caption>Enable Benchmark Reference Line</caption>
                <description>Renders a benchmark/average line (e.g., National or State average)</description>
            </property>

            <property key="benchmarkValue" type="expression" required="false">
                <caption>Benchmark Value (Average / Target)</caption>
                <description>Numerical value for the reference benchmark line (e.g. 75% or 100000)</description>
                <returnType type="Decimal"/>
            </property>

            <property key="benchmarkLabel" type="string" required="false" defaultValue="Target / Benchmark">
                <caption>Benchmark Line Label</caption>
                <description>Label displayed next to the reference line</description>
            </property>

            <property key="enableRAGColoring" type="boolean" defaultValue="false">
                <caption>Enable RAG Performance Coloring (Red/Amber/Green)</caption>
                <description>Dynamically colors bars/regions based on performance thresholds to highlight low/high performers</description>
            </property>

            <property key="ragRedThreshold" type="expression" required="false">
                <caption>Red Threshold (Below = Underperforming Alert)</caption>
                <description>Values below this are marked Red (critical attention needed). Default 60.</description>
                <returnType type="Decimal"/>
            </property>

            <property key="ragGreenThreshold" type="expression" required="false">
                <caption>Green Threshold (Above = Star Performer)</caption>
                <description>Values above this are marked Green (high performance). Default 90.</description>
                <returnType type="Decimal"/>
            </property>

            <property key="sortMode" type="enumeration" defaultValue="none">
                <caption>Performance Sorting / Leaderboard</caption>
                <description>Sort bars to identify high vs low performers</description>
                <enumerationValues>
                    <enumerationValue key="none">Default (Datasource Order)</enumerationValue>
                    <enumerationValue key="descending">Ranked: Top Performers First (Leaderboard)</enumerationValue>
                    <enumerationValue key="ascending">Ranked: Lowest Performers First (Priority Intervention)</enumerationValue>
                    <enumerationValue key="topBottomN">Isolate: Top N and Bottom N Extremes</enumerationValue>
                </enumerationValues>
            </property>

            <property key="topBottomCount" type="integer" defaultValue="5">
                <caption>Top / Bottom N Count</caption>
                <description>Number of top and bottom items to show when 'Isolate: Top N and Bottom N Extremes' is selected</description>
            </property>

            <property key="enableBreadcrumb" type="boolean" defaultValue="true">
                <caption>Enable Drill-Down Breadcrumbs</caption>
                <description>Displays an interactive breadcrumb trail (e.g. All &gt; Maharashtra &gt; Pune) with instant back navigation</description>
            </property>
        </propertyGroup>

        <!-- TAB 4: MAP SETTINGS -->
        <propertyGroup caption="Map &amp; Geospatial">
            <property key="mapGeoJsonUrl" type="expression" required="false">
                <caption>Custom GeoJSON URL</caption>
                <description>URL to fetch custom state/district GeoJSON. Defaults to built-in world/India map if left blank.</description>
                <returnType type="String"/>
            </property>

            <property key="mapVisualMin" type="integer" defaultValue="0">
                <caption>Map Value Range Min</caption>
                <description>Lower boundary for choropleth color scale</description>
            </property>

            <property key="mapVisualMax" type="integer" defaultValue="1000">
                <caption>Map Value Range Max</caption>
                <description>Upper boundary for choropleth color scale</description>
            </property>

            <property key="mapRoam" type="boolean" defaultValue="true">
                <caption>Map Zoom &amp; Pan</caption>
                <description>Allow users to pinch-zoom and pan the map on mobile and desktop</description>
            </property>
        </propertyGroup>

        <!-- TAB 5: RESPONSIVENESS & INTERACTIVITY -->
        <propertyGroup caption="Responsive &amp; Controls">
            <property key="legendPosition" type="enumeration" defaultValue="top">
                <caption>Legend Position</caption>
                <description>Where the chart legend should render</description>
                <enumerationValues>
                    <enumerationValue key="top">Top</enumerationValue>
                    <enumerationValue key="bottom">Bottom</enumerationValue>
                    <enumerationValue key="left">Left</enumerationValue>
                    <enumerationValue key="right">Right</enumerationValue>
                    <enumerationValue key="none">Hidden</enumerationValue>
                </enumerationValues>
            </property>

            <property key="enableDataZoom" type="boolean" defaultValue="true">
                <caption>Mobile Pinch-Zoom &amp; Slider</caption>
                <description>Enables mobile pinch-to-zoom, touch panning, and bottom slider for dense charts</description>
            </property>

            <property key="showToolbox" type="boolean" defaultValue="true">
                <caption>Show Toolbox (Save Image / Data View)</caption>
                <description>Displays export image, zoom restore, and data view buttons</description>
            </property>

            <property key="smoothCurves" type="boolean" defaultValue="true">
                <caption>Smooth Spline Curves (Line/Area)</caption>
                <description>Smooth curves vs straight lines</description>
            </property>

            <property key="donutRatio" type="string" defaultValue="45%">
                <caption>Pie Donut Inner Radius</caption>
                <description>Inner radius for Pie/Donut (e.g. 0% for full pie, 50% for donut)</description>
            </property>

            <property key="onClickAction" type="action" dataSource="mendixDatasource" required="false">
                <caption>On Data Point Click Action</caption>
                <description>Microflow or Nanoflow to execute when clicking a data item</description>
            </property>
        </propertyGroup>

        <!-- TAB 6: ADVANCED JSON OVERRIDE -->
        <propertyGroup caption="Advanced Options">
            <property key="customJsonOptions" type="expression" required="false">
                <caption>Custom ECharts JSON Override</caption>
                <description>Advanced: dynamic JSON expression deep-merged into ECharts options for 100% custom styling</description>
                <returnType type="String"/>
            </property>
        </propertyGroup>
    </properties>
</widget>
